# Values from AWS's AgentCore Payments Tutorial 00.
# For local use only. In a deployed agent, keep these in Secrets Manager.
AWS_REGION=us-east-1
PAYMENT_MANAGER_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:payment-manager/your-manager-id
PAYMENT_INSTRUMENT_ID=your-instrument-id
USER_ID=your-user-id

# Optional
SESSION_BUDGET_USD=0.50
MODEL_ID=us.anthropic.claude-sonnet-4-6
